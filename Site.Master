<%@ Master Language="VB" AutoEventWireup="true" CodeBehind="Site.Master.vb" Inherits="GestionProyectosAcademicosWeb.SiteMaster" %>

<!DOCTYPE html>
<html lang="es">
<head runat="server">
    <meta charset="utf-8" />
    <title><%: Page.Title %> - Gestión Académica</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />

    <style>
        body {
            background: linear-gradient(180deg, #f5f7fb 0%, #eef3ff 100%);
            min-height: 100vh;
        }

        .navbar-brand {
            font-weight: 700;
            letter-spacing: .3px;
        }

        .main-card {
            background: white;
            border-radius: 18px;
            box-shadow: 0 10px 30px rgba(0,0,0,.08);
            padding: 28px;
            margin-top: 28px;
            margin-bottom: 28px;
        }

        .page-title {
            font-weight: 700;
            margin-bottom: 20px;
        }

        .table th {
            background: #0d6efd;
            color: white;
            vertical-align: middle;
        }

        .table td {
            vertical-align: middle;
        }

        .user-badge {
            background: rgba(255,255,255,.15);
            border: 1px solid rgba(255,255,255,.25);
            border-radius: 999px;
            padding: 6px 12px;
        }
    </style>

    <asp:ContentPlaceHolder ID="head" runat="server" />
</head>
<body>
    <form id="form1" runat="server">

        <asp:Panel ID="pnlNavbar" runat="server">
            <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
                <div class="container">
                    <a class="navbar-brand" href="Proyectos.aspx">
                        <i class="bi bi-kanban-fill"></i> Gestión Académica
                    </a>

                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuNav">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="menuNav">
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                            <li class="nav-item">
                                <a class="nav-link" href="Proyectos.aspx">
                                    <i class="bi bi-folder2-open"></i> Proyectos
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="Comentarios.aspx">
                                    <i class="bi bi-chat-left-text"></i> Observaciones
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="Entregas.aspx">
                                    <i class="bi bi-upload"></i> Entregas
                                </a>
                            </li>
                            <li class="nav-item" runat="server" id="liUsuarios">
                                <a class="nav-link" href="Usuarios.aspx">
                                    <i class="bi bi-people"></i> Usuarios
                                </a>
                            </li>
                        </ul>

                        <div class="d-flex align-items-center gap-3 text-white">
                            <asp:Label ID="lblUsuario" runat="server" CssClass="fw-semibold user-badge"></asp:Label>
                            <a href="Logout.aspx" class="btn btn-light btn-sm">
                                <i class="bi bi-box-arrow-right"></i> Salir
                            </a>
                        </div>
                    </div>
                </div>
            </nav>
        </asp:Panel>

        <div class="container">
            <div class="main-card">
                <asp:ContentPlaceHolder ID="MainContent" runat="server" />
            </div>
        </div>
    </form>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</body>
</html>